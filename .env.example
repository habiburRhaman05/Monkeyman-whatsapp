# === Evolution API (Docker) ===
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-long-random

# === Backend ===
WEBHOOK_SECRET=change-me-random
WEBHOOK_BASE_URL=http://host.docker.internal:8000
DATABASE_URL=sqlite:///./data/app.db
FRONTEND_ORIGIN=http://localhost:3001
# true = opening a chat sends real read receipts (blue ticks) and clears the unread count on your phone
SEND_READ_RECEIPTS=true

# === Frontend (Next.js) ===
# Leave unset to use the built-in /api proxy (recommended). Only set a full URL to bypass it.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# === Postgres for Evolution ===
POSTGRES_USER=evolution
POSTGRES_PASSWORD=change-me
POSTGRES_DB=evolution
